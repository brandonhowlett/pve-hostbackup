[Unit]
Description=Proxmox Host Configuration Backup — Timer
Documentation=https://github.com/YOUR_USERNAME/pve-hostbackup

[Timer]
# Run a missed backup on next boot (host may have been off at scheduled time)
Persistent=true

# First run: 10 minutes after boot (PVE services need time to settle)
OnBootSec=10min

# Interval: must match BACKUP_INTERVAL_DAYS in pve-hostbackup.conf
# After editing: systemctl daemon-reload && systemctl restart pve-hostbackup.timer
# 1d = daily | 3d = every 3 days | 7d = weekly
OnUnitActiveSec=3d

# Spread start time ±15 minutes to avoid precise midnight hammering
RandomizedDelaySec=900

Unit=pve-hostbackup.service

[Install]
WantedBy=timers.target
